cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Embedding requires INPUT and OUTPUT")
endif()
file(READ "${INPUT}" contents HEX)
# The optional UTF-8 BOM is encoding metadata, not the first Tcl command.
string(REGEX REPLACE "^efbbbf" "" contents "${contents}")
string(REGEX MATCHALL ".." bytes "${contents}")
set(remaining 0)
set(minimum 128)
set(maximum 191)
set(column 0)
set(previous_cr FALSE)
set(data "")
foreach(byte IN LISTS bytes)
    math(EXPR value "0x${byte}")
    if(remaining GREATER 0)
        if(value LESS minimum OR value GREATER maximum)
            message(FATAL_ERROR "Startup script must be valid UTF-8: ${INPUT}")
        endif()
        math(EXPR remaining "${remaining} - 1")
        set(minimum 128)
        set(maximum 191)
    elseif(value EQUAL 0)
        message(FATAL_ERROR "Startup script must not contain NUL bytes: ${INPUT}")
    elseif(value LESS 128)
        # ASCII, including whitespace, is already a complete code point.
    elseif(value GREATER_EQUAL 194 AND value LESS_EQUAL 223)
        set(remaining 1)
    elseif(value GREATER_EQUAL 224 AND value LESS_EQUAL 239)
        set(remaining 2)
        if(value EQUAL 224)
            set(minimum 160)
        elseif(value EQUAL 237)
            set(maximum 159)
        endif()
    elseif(value GREATER_EQUAL 240 AND value LESS_EQUAL 244)
        set(remaining 3)
        if(value EQUAL 240)
            set(minimum 144)
        elseif(value EQUAL 244)
            set(maximum 143)
        endif()
    else()
        message(FATAL_ERROR "Startup script must be valid UTF-8: ${INPUT}")
    endif()

    # Match Tcl text-file newline translation without changing the source file.
    if(previous_cr AND value EQUAL 10)
        set(previous_cr FALSE)
        continue()
    endif()
    set(previous_cr FALSE)
    if(value EQUAL 13)
        set(byte "0a")
        set(previous_cr TRUE)
    endif()

    # Numeric character literals preserve quotes, backslashes, CMake variables
    # and Unicode bytes without a compiler-dependent string-literal size limit.
    string(APPEND data "'\\x${byte}',")
    math(EXPR column "${column} + 1")
    if(column EQUAL 16)
        string(APPEND data "\n")
        set(column 0)
    endif()
endforeach()
if(NOT remaining EQUAL 0)
    message(FATAL_ERROR "Startup script ends with incomplete UTF-8: ${INPUT}")
endif()
get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
# Only replace the generated header after the entire input has been validated.
file(WRITE "${OUTPUT}" "#pragma once\n#include <string_view>\nnamespace vinc::app {\ninline constexpr char startup_bytes[] = {\n${data}'\\0'};\ninline constexpr std::string_view startup_script{startup_bytes, sizeof(startup_bytes) - 1};\n}\n")
