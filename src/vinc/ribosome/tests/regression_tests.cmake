file(WRITE "${input}/Point.msg" "int x;\nfloat y;\ndouble scale = 010;\n")
run_case(canonical_float_before TRUE "")
file(READ "${output}/Frame.hpp" first_float)
file(WRITE "${input}/Point.msg" "int32_t x;\nfloat y;\ndouble scale = 10.0;\n")
run_case(canonical_float_after TRUE "")
file(READ "${output}/Frame.hpp" second_float)
if(NOT first_float STREQUAL second_float)
    message(FATAL_ERROR "Equivalent floating values changed parent schema")
endif()
file(WRITE "${input}/Point.msg" "int x;\nfloat y;\ndouble scale = 11.0;\n")
run_case(changed_float TRUE "")
file(READ "${output}/Frame.hpp" changed_float)
if(second_float STREQUAL changed_float)
    message(FATAL_ERROR "Changed constant did not affect parent schema")
endif()

foreach(source IN ITEMS
    [=[${DO_INCLUDE_DEPENDENT_MESSAGES}${DO_MESSAGE_CLASS}${UNKNOWN}]=]
    [=[${DO_INCLUDE_DEPENDENT_MESSAGES}${DO_MESSAGE_CLASS}${DO_MESSAGE_CLASS}]=]
    [=[${DO_INCLUDE_DEPENDENT_MESSAGES}${DO_MESSAGE_CLASS}${]=])
    file(WRITE "${template}" "${source}")
    run_case(template_validation FALSE "template placeholder")
endforeach()
configure_file("${TEMPLATE}" "${template}" COPYONLY)
run_case(template_recovery TRUE "")

function(depth_case count reverse leaf expect_success)
    set(case "${root}/depth-${count}-${reverse}-${leaf}")
    file(MAKE_DIRECTORY "${case}/input")
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        math(EXPR next "${i} + 1")
        if(reverse)
            math(EXPR current "1000 + ${last} - ${i}")
            math(EXPR dependent "${current} - 1")
        else()
            math(EXPR current "1000 + ${i}")
            math(EXPR dependent "${current} + 1")
        endif()
        if(i EQUAL last)
            set(content "")
            if(leaf STREQUAL scalar)
                set(content "int value;\n")
            endif()
        else()
            set(content "M${dependent} child;\n")
        endif()
        file(WRITE "${case}/input/M${current}.msg" "${content}")
    endforeach()
    execute_process(COMMAND "${GENERATOR}" --input "${case}/input" --output "${case}/output"
        --template "${template}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors TIMEOUT 20 ENCODING UTF-8)
    file(WRITE "${case}/result.log" "${log}\n${errors}")
    if(expect_success)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Depth boundary should succeed: ${case}: ${errors}")
        endif()
    elseif(result STREQUAL "0" OR NOT errors MATCHES "nesting exceeds 64" OR EXISTS "${case}/output")
        message(FATAL_ERROR "Depth boundary should fail cleanly: ${case}: ${errors}")
    endif()
    if(EXISTS "${case}/output.ribosome-stage")
        message(FATAL_ERROR "Depth failure leaked staging")
    endif()
endfunction()
foreach(reverse IN ITEMS TRUE FALSE)
    depth_case(70 ${reverse} scalar FALSE)
    depth_case(66 ${reverse} empty FALSE)
    depth_case(65 ${reverse} empty TRUE)
    depth_case(65 ${reverse} scalar FALSE)
    depth_case(64 ${reverse} scalar TRUE)
endforeach()
message(STATUS "PASS: depth boundaries in both traversal orders")

set(unicode_root "${root}/路徑🚀")
file(MAKE_DIRECTORY "${unicode_root}/來源🚀")
file(WRITE "${unicode_root}/來源🚀/Probe.msg" "int value;\n")
configure_file("${TEMPLATE}" "${unicode_root}/模板🚀.txt" COPYONLY)
execute_process(COMMAND "${GENERATOR}" --input "${unicode_root}/來源🚀"
    --output "${unicode_root}/產出🚀" --template "${unicode_root}/模板🚀.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors TIMEOUT 20 ENCODING UTF-8)
if(NOT result STREQUAL "0" OR NOT EXISTS "${unicode_root}/產出🚀/Probe.hpp")
    message(FATAL_ERROR "Unicode path failed: ${log} ${errors}")
endif()
file(WRITE "${unicode_root}/來源🚀/Probe.msg" "int value = bad;\n")
execute_process(COMMAND "${GENERATOR}" --input "${unicode_root}/來源🚀"
    --output "${unicode_root}/產出🚀" --template "${unicode_root}/模板🚀.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors TIMEOUT 20 ENCODING UTF-8)
string(REPLACE "\\" "/" normalized_errors "${errors}")
if(result STREQUAL "0" OR NOT normalized_errors MATCHES "來源🚀/Probe.msg:1: error:" OR
    EXISTS "${unicode_root}/產出🚀" OR EXISTS "${unicode_root}/產出🚀.ribosome-stage")
    message(FATAL_ERROR "Unicode failure diagnostics/cleanup failed: ${errors}")
endif()
message(STATUS "PASS: Unicode input, output, template and diagnostics")
