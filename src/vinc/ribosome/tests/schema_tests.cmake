cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED GENERATOR OR NOT DEFINED WORK OR NOT DEFINED TEMPLATE)
    message(FATAL_ERROR "GENERATOR, WORK and TEMPLATE are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(root "${WORK}/${run}")
file(MAKE_DIRECTORY "${root}/input")
set(input "${root}/input")
set(output "${root}/output")
set(template "${root}/template.txt")
configure_file("${TEMPLATE}" "${template}" COPYONLY)
file(WRITE "${input}/Point.msg" "int x;\nfloat y;\n")
file(WRITE "${input}/Frame.msg" "Point[] points;\nPoint[][] groups;\nbool[] flags;\nstring title;\n")
function(run_case name success diagnostic)
    execute_process(COMMAND "${GENERATOR}" --input "${input}" --output "${output}" --template "${template}"
        RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors TIMEOUT 20)
    file(WRITE "${root}/${name}.log" "${log}\n${errors}")
    if(success)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${name}: ${log}\n${errors}")
        endif()
    else()
        if(result STREQUAL "0" OR NOT "${errors}" MATCHES "${diagnostic}" OR EXISTS "${output}")
            message(FATAL_ERROR "${name}: expected clean failure ${diagnostic}: ${result} ${errors}")
        endif()
    endif()
    if(EXISTS "${output}.ribosome-stage")
        message(FATAL_ERROR "${name}: staging leak")
    endif()
    message(STATUS "PASS: ${name}")
endfunction()
run_case(valid TRUE "")
file(READ "${output}/Frame.hpp" original)
file(WRITE "${input}/Point.msg" "# comment\nint32_t x; // canonical alias\nfloat y;\n")
run_case(alias_normalization TRUE "")
file(READ "${output}/Frame.hpp" same)
if(NOT original STREQUAL same)
    message(FATAL_ERROR "Canonical aliases/comments changed parent schema")
endif()
file(APPEND "${input}/Point.msg" "uint64_t z;\n")
run_case(transitive_hash TRUE "")
file(READ "${output}/Frame.hpp" changed)
if(original STREQUAL changed)
    message(FATAL_ERROR "Nested schema change did not affect parent")
endif()
file(WRITE "${input}/Bad.msg" "uint8_t x;\nuint8_t x;\n")
run_case(duplicate FALSE "duplicate field")
file(WRITE "${input}/Bad.msg" "missing_type x;\n")
run_case(unknown_type FALSE "Unknown type")
file(WRITE "${input}/Bad.msg" "Bad[] children;\n")
run_case(self_cycle FALSE "cyclic")
file(WRITE "${input}/Bad.msg" "Cycle child;\n")
file(WRITE "${input}/Cycle.msg" "Bad[] children;\n")
run_case(indirect_cycle FALSE "cyclic")
file(REMOVE "${input}/Cycle.msg")
foreach(declaration IN ITEMS "uint8_t value = 256;" "int8_t value = -129;" "uint64_t value = -1;" "bool value = 3;" "int[] value = 3;")
    file(WRITE "${input}/Bad.msg" "${declaration}\n")
    run_case(invalid_constant FALSE "constant")
endforeach()
foreach(declaration IN ITEMS "int[3] values;" "int[][][]] values;" "int[] values[];" "int schema;" "int value; int other;")
    file(WRITE "${input}/Bad.msg" "${declaration}\n")
    run_case(invalid_declaration FALSE "error:")
endforeach()
file(REMOVE "${input}/Bad.msg")
file(WRITE "${input}/PointData_t.msg" "uint8_t value;\n")
run_case(symbol_collision FALSE "symbol collision")
file(REMOVE "${input}/PointData_t.msg")
run_case(recovery TRUE "")
file(WRITE "${template}" " ")
run_case(empty_template FALSE "template is empty")
file(WRITE "${template}" "#pragma once\n")
run_case(invalid_template FALSE "placeholder")
file(REMOVE "${template}")
run_case(missing_template FALSE "Failed to open message template")
configure_file("${TEMPLATE}" "${template}" COPYONLY)
run_case(final_recovery TRUE "")
execute_process(COMMAND "${GENERATOR}" --input "${input}" --output "${root}" --template "${template}"
    RESULT_VARIABLE protected_result OUTPUT_QUIET ERROR_VARIABLE protected_error TIMEOUT 20)
if(protected_result STREQUAL "0" OR NOT EXISTS "${input}/Frame.msg" OR NOT protected_error MATCHES "contains an input")
    message(FATAL_ERROR "Output/input overlap protection failed")
endif()
message(STATUS "PASS: output/input overlap protection")
