cmake_minimum_required(VERSION 3.20)
set(generator_arguments -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND generator_arguments -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND generator_arguments -T "${TOOLSET}")
endif()
foreach(case IN ITEMS native standalone static mixed undeclared invalid)
    set(binary "${WORK}/${case}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE}" -B "${binary}"
        ${generator_arguments} "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_BUILD_TYPE=${CONFIG}"
        "-DPOLICY=${POLICY}" "-DCASE=${case}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(case STREQUAL "mixed" OR case STREQUAL "undeclared" OR case STREQUAL "invalid")
        if(result EQUAL 0)
            message(FATAL_ERROR "${case} unexpectedly configured")
        endif()
        if(case STREQUAL "mixed" AND NOT "${output}${error}" MATCHES "VINC_CRT")
            message(FATAL_ERROR "Mixed runtime failed for an unrelated reason: ${output}${error}")
        elseif(case STREQUAL "undeclared" AND NOT "${output}${error}" MATCHES "no declared Python runtime variant")
            message(FATAL_ERROR "Missing variant failed for an unrelated reason: ${output}${error}")
        elseif(case STREQUAL "invalid" AND NOT "${output}${error}" MATCHES "Unsupported Vinc runtime variant")
            message(FATAL_ERROR "Unknown variant failed for an unrelated reason: ${output}${error}")
        endif()
        continue()
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} configure failed: ${output}${error}")
    endif()
    set(build_arguments)
    if(case STREQUAL "static")
        list(APPEND build_arguments --target consumer)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}" --config "${CONFIG}" ${build_arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} build failed: ${output}${error}")
    endif()
    if(case STREQUAL "native")
        file(GLOB_RECURSE static_archives "${binary}/*fixture_python_runtime*.lib")
        if(static_archives)
            message(FATAL_ERROR "Default native build unexpectedly built static-CRT archives: ${static_archives}")
        endif()
    endif()
    execute_process(COMMAND "${CTEST}" --test-dir "${binary}" -C "${CONFIG}" --output-on-failure
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${case} execution failed: ${output}${error}")
    endif()
endforeach()
