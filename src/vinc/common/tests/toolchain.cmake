include("${CMAKE_CURRENT_LIST_DIR}/../cmake/VincToolchain.cmake")

function(check_case compiler version rejected)
    set(CMAKE_CXX_COMPILER_LOADED TRUE)
    set(CMAKE_CXX_COMPILER_ID "${compiler}")
    set(CMAKE_CXX_COMPILER_VERSION "${version}")
    vinc_check_toolchain(error)
    if(rejected AND NOT error MATCHES "requires MSVC 19.44")
        message(FATAL_ERROR "Expected minimum-version rejection: ${compiler} ${version}: ${error}")
    elseif(NOT rejected AND error)
        message(FATAL_ERROR "Unexpected rejection: ${error}")
    endif()
endfunction()

check_case(MSVC 19.43.99999 TRUE)
check_case(MSVC 19.44 FALSE)
check_case(MSVC 19.44.1 FALSE)
check_case(MSVC 19.51.36257 FALSE)
check_case(MSVC "" TRUE)
check_case(Clang 18.1 FALSE)
check_case(GNU 14.2 FALSE)
set(CMAKE_C_COMPILER_LOADED TRUE)
set(CMAKE_C_COMPILER_ID MSVC)
set(CMAKE_C_COMPILER_VERSION 19.43)
check_case(MSVC 19.44 TRUE)
