include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/VincPythonRequirements.cmake")

function(vinc_reject_python_override)
    if(DEFINED Python_EXECUTABLE)
        message(FATAL_ERROR "Python_EXECUTABLE is no longer an Open-VINC setting. Select System/Custom Python in your App Kconfig (CONFIG_VINC_PYTHON_CUSTOM and CONFIG_VINC_PYTHON_EXECUTABLE). Remove -DPython_EXECUTABLE; for an old cache use cmake -U Python_EXECUTABLE. Python3_EXECUTABLE still selects the configuration tool only.")
    endif()
endfunction()

# Resolve each App independently before sharing a binding. Never resolve symlinks:
# a venv executable may point at the system binary but has different site packages.
function(vinc_select_module_python app)
    if(VINC_PYTHON_CUSTOM)
        set(selected "${VINC_PYTHON_EXECUTABLE}")
        if(NOT IS_ABSOLUTE "${selected}")
            message(FATAL_ERROR "App ${app}: custom Python requires an absolute executable path")
        endif()
    else()
        set(name python3)
        if(WIN32)
            set(name python.exe)
        endif()
        unset(_vinc_path_python CACHE)
        find_program(_vinc_path_python NAMES "${name}" PATHS ENV PATH NO_DEFAULT_PATH)
        set(selected "${_vinc_path_python}")
        unset(_vinc_path_python CACHE)
    endif()
    if(NOT selected OR NOT EXISTS "${selected}" OR IS_DIRECTORY "${selected}")
        message(FATAL_ERROR "App ${app}: Module Python not found: ${selected}. System mode uses only PATH. Install dependencies with tools/setup.bat or bash tools/setup.sh, or select an absolute path in Kconfig.")
    endif()
    get_filename_component(selected "${selected}" ABSOLUTE)
    string(FIND "${selected}" "$<" generator_expression)
    if(NOT generator_expression EQUAL -1)
        message(FATAL_ERROR "Module Python path must not contain CMake generator-expression syntax ($<): ${selected}")
    endif()
    execute_process(COMMAND "${selected}" -c
        "import json,platform,struct,sys,sysconfig; print(json.dumps([platform.python_implementation(),platform.python_version(),str(sys.version_info[0])+'.'+str(sys.version_info[1]),struct.calcsize('P'),sysconfig.get_platform(),bool(sysconfig.get_config_var('Py_GIL_DISABLED'))]))"
        RESULT_VARIABLE result OUTPUT_VARIABLE details ERROR_VARIABLE errors
        OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 10)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "App ${app}: cannot inspect Module Python ${selected}: ${result}\n${errors}")
    endif()
    string(JSON implementation ERROR_VARIABLE parse_error GET "${details}" 0)
    if(parse_error)
        message(FATAL_ERROR "App ${app}: invalid Python probe output from ${selected}: ${details}")
    endif()
    string(JSON version GET "${details}" 1)
    string(JSON abi GET "${details}" 2)
    string(JSON pointer_bytes GET "${details}" 3)
    string(JSON platform GET "${details}" 4)
    string(JSON free_threaded GET "${details}" 5)
    vinc_python_minimum(minimum)
    if(NOT implementation STREQUAL "CPython" OR version VERSION_LESS minimum OR
            NOT version VERSION_LESS "4" OR NOT pointer_bytes EQUAL 8 OR free_threaded)
        message(FATAL_ERROR "App ${app}: requires 64-bit GIL-enabled CPython >= ${minimum}, < 4. Found ${implementation} ${version}, ${pointer_bytes}-byte pointers, free-threaded=${free_threaded} at ${selected}. Select a compatible interpreter in Kconfig; see tools/setup.bat --recommended or bash tools/setup.sh --recommended.")
    endif()
    set(identity "${selected}")
    if(WIN32)
        string(TOLOWER "${identity}" identity)
    endif()
    set(abi "${abi}/${pointer_bytes}/${platform}")
    get_property(previous GLOBAL PROPERTY VINC_SELECTED_PYTHON_IDENTITY)
    get_property(previous_app GLOBAL PROPERTY VINC_SELECTED_PYTHON_APP)
    get_property(previous_version GLOBAL PROPERTY VINC_SELECTED_PYTHON_VERSION)
    if(previous AND NOT previous STREQUAL identity)
        message(FATAL_ERROR "Apps in one build must use the same Python interpreter.\nApp ${previous_app}: ${previous} (${previous_version})\nApp ${app}: ${selected} (${version})\nUse separate build directories for different Python environments.")
    endif()
    if(DEFINED _VINC_MODULE_PYTHON_IDENTITY AND
            (NOT _VINC_MODULE_PYTHON_IDENTITY STREQUAL identity OR NOT _VINC_MODULE_PYTHON_ABI STREQUAL abi))
        message(FATAL_ERROR "App ${app}: Python environment differs from this build cache.\nPrevious: ${_VINC_MODULE_PYTHON_IDENTITY} (${_VINC_MODULE_PYTHON_ABI})\nSelected: ${selected} (${abi})\nSelect another build directory; no files were cleaned.")
    endif()
    # Guard pre-selection builds too, after removal of their obsolete public input.
    if(NOT DEFINED _VINC_MODULE_PYTHON_IDENTITY AND DEFINED _Python_INTERPRETER_PROPERTIES)
        get_filename_component(old_identity "${_Python_EXECUTABLE}" ABSOLUTE)
        if(WIN32)
            string(TOLOWER "${old_identity}" old_identity)
        endif()
        list(GET _Python_INTERPRETER_PROPERTIES 1 old_major)
        list(GET _Python_INTERPRETER_PROPERTIES 2 old_minor)
        if(NOT old_identity STREQUAL identity OR NOT abi MATCHES "^${old_major}\\.${old_minor}/")
            message(FATAL_ERROR "Existing Python binding cache differs from Kconfig selection ${selected}. Select another build directory; no files were cleaned.")
        endif()
    endif()
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_IDENTITY "${identity}")
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_APP "${app}")
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_VERSION "${version}")
    set(_VINC_MODULE_PYTHON_IDENTITY "${identity}" CACHE INTERNAL "Kconfig binding interpreter" FORCE)
    set(_VINC_MODULE_PYTHON_ABI "${abi}" CACHE INTERNAL "Kconfig binding ABI" FORCE)
    set(VINC_SELECTED_PYTHON "${selected}" PARENT_SCOPE)
    message(STATUS "App ${app}: Module Python ${selected} (${version}; ${abi})")
endfunction()
