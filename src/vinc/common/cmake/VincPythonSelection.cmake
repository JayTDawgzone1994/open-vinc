include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/VincPythonRequirements.cmake")

# One build-only probe supplies selection policy and binding metadata. Do not
# persist its result across configure runs or canonicalize a venv executable.
function(vinc_probe_module_python app executable output)
    set(probe_timeout_seconds 10)
    execute_process(COMMAND "${executable}" -c
        "import json,platform,struct,sys,sysconfig; print(json.dumps(dict(implementation=platform.python_implementation(),version=platform.python_version(),pointer_bytes=struct.calcsize('P'),platform=sysconfig.get_platform(),free_threaded=bool(sysconfig.get_config_var('Py_GIL_DISABLED')))))"
        RESULT_VARIABLE result OUTPUT_VARIABLE details ERROR_VARIABLE errors
        OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT ${probe_timeout_seconds})
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "App ${app}: cannot inspect Module Python ${executable} (limit ${probe_timeout_seconds}s): ${result}\n${errors}")
    endif()

    string(JSON root_type ERROR_VARIABLE parse_error TYPE "${details}")
    if(parse_error OR NOT root_type STREQUAL "OBJECT")
        message(FATAL_ERROR "App ${app}: invalid Python probe output from ${executable}: expected a JSON object.\n${details}\n${errors}")
    endif()
    foreach(field implementation version pointer_bytes platform free_threaded)
        set(expected_type STRING)
        if(field STREQUAL "pointer_bytes")
            set(expected_type NUMBER)
        elseif(field STREQUAL "free_threaded")
            set(expected_type BOOLEAN)
        endif()
        string(JSON field_type ERROR_VARIABLE parse_error TYPE "${details}" "${field}")
        if(parse_error OR NOT field_type STREQUAL expected_type)
            message(FATAL_ERROR "App ${app}: invalid Python probe output from ${executable}: field '${field}' must be ${expected_type}.\n${details}\n${errors}")
        endif()
        string(JSON ${field} GET "${details}" "${field}")
    endforeach()
    if(NOT version MATCHES "^([0-9]+)[.]([0-9]+)[.]([0-9]+)$")
        message(FATAL_ERROR "App ${app}: invalid Python probe output from ${executable}: invalid version '${version}'")
    endif()
    set(version_major "${CMAKE_MATCH_1}")
    set(version_minor "${CMAKE_MATCH_2}")
    if(implementation STREQUAL "" OR platform STREQUAL "" OR NOT pointer_bytes MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "App ${app}: invalid Python probe output from ${executable}: empty identity/platform or invalid pointer size")
    endif()

    vinc_python_minimum(minimum)
    if(NOT implementation STREQUAL "CPython" OR version VERSION_LESS minimum OR
            NOT version VERSION_LESS "4" OR NOT pointer_bytes EQUAL 8 OR free_threaded)
        message(FATAL_ERROR "App ${app}: requires 64-bit GIL-enabled CPython >= ${minimum}, < 4. Found ${implementation} ${version}, ${pointer_bytes}-byte pointers, free-threaded=${free_threaded} at ${executable}. Select a compatible interpreter in Kconfig; see tools/setup.bat --recommended or bash tools/setup.sh --recommended.")
    endif()
    foreach(field version version_major version_minor pointer_bytes platform)
        string(TOUPPER "${field}" suffix)
        set(${output}_${suffix} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

# Resolve each App independently before sharing a binding. Never resolve symlinks:
# a venv executable may point at the system binary but has different site packages.
function(vinc_select_module_python app)
    if(VINC_PYTHON_CUSTOM)
        set(selected "${VINC_PYTHON_EXECUTABLE}")
        if(NOT IS_ABSOLUTE "${selected}")
            message(FATAL_ERROR "App ${app}: custom Python requires an absolute executable path")
        endif()
    else()
        set(name python3)
        if(WIN32)
            set(name python.exe)
        endif()
        unset(_vinc_path_python CACHE)
        # Resolve a host interpreter from PATH only. Parent bundle/sysroot settings
        # must not select a different environment than the deployed App would use.
        set(_vinc_path_python "_vinc_path_python-NOTFOUND")
        set(CMAKE_FIND_APPBUNDLE NEVER)
        # PATHS ENV PATH treats empty entries as cwd. Runtime intentionally does
        # not: only an explicit '.' or relative directory may select from cwd.
        file(TO_CMAKE_PATH "$ENV{PATH}" _vinc_python_paths)
        list(FILTER _vinc_python_paths EXCLUDE REGEX "^$")
        list(LENGTH _vinc_python_paths _vinc_python_path_count)
        cmake_policy(PUSH)
        cmake_policy(SET CMP0109 NEW)
        if(_vinc_python_path_count GREATER 0)
            find_program(_vinc_path_python NAMES "${name}" PATHS ${_vinc_python_paths}
                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
        endif()
        cmake_policy(POP)
        set(selected "${_vinc_path_python}")
        unset(_vinc_path_python CACHE)
    endif()
    if(NOT selected OR NOT EXISTS "${selected}" OR IS_DIRECTORY "${selected}")
        message(FATAL_ERROR "App ${app}: Module Python not found: ${selected}. System mode uses only PATH. Install dependencies with tools/setup.bat or bash tools/setup.sh, or select an absolute path in Kconfig.")
    endif()
    get_filename_component(selected "${selected}" ABSOLUTE)
    string(FIND "${selected}" "$<" generator_expression)
    if(NOT generator_expression EQUAL -1)
        message(FATAL_ERROR "Module Python path must not contain CMake generator-expression syntax ($<): ${selected}")
    endif()
    vinc_probe_module_python("${app}" "${selected}" probe)
    set(version "${probe_VERSION}")
    set(identity "${selected}")
    if(WIN32)
        string(TOLOWER "${identity}" identity)
    endif()
    set(abi "${probe_VERSION_MAJOR}.${probe_VERSION_MINOR}/${probe_POINTER_BYTES}/${probe_PLATFORM}")
    get_property(previous GLOBAL PROPERTY VINC_SELECTED_PYTHON_IDENTITY)
    get_property(previous_app GLOBAL PROPERTY VINC_SELECTED_PYTHON_APP)
    get_property(previous_version GLOBAL PROPERTY VINC_SELECTED_PYTHON_VERSION)
    if(previous AND NOT previous STREQUAL identity)
        message(FATAL_ERROR "Apps in one build must use the same Python interpreter.\nApp ${previous_app}: ${previous} (${previous_version})\nApp ${app}: ${selected} (${version})\nUse separate build directories for different Python environments.")
    endif()
    if(DEFINED _VINC_MODULE_PYTHON_IDENTITY AND
            (NOT _VINC_MODULE_PYTHON_IDENTITY STREQUAL identity OR NOT _VINC_MODULE_PYTHON_ABI STREQUAL abi))
        message(FATAL_ERROR "App ${app}: Python environment differs from this build cache.\nPrevious: ${_VINC_MODULE_PYTHON_IDENTITY} (${_VINC_MODULE_PYTHON_ABI})\nSelected: ${selected} (${abi})\nSelect another build directory; no files were cleaned.")
    endif()
    # FindPython's cache belongs to all consumers, not necessarily VINC. Only
    # VINC's generated package is evidence of an older binding without identity.
    # Its ABI metadata does not record the interpreter path, so do not guess one.
    if(NOT DEFINED _VINC_MODULE_PYTHON_IDENTITY)
        set(package_roots "${CMAKE_BINARY_DIR}/vinc-python")
        if(DEFINED VINC_BUILD_ROOT)
            list(APPEND package_roots "${VINC_BUILD_ROOT}/python")
        endif()
        foreach(package_root IN LISTS package_roots)
            file(GLOB legacy_metadata
                "${package_root}/vinc/_build.py"
                "${package_root}/*/vinc/_build.py")
            if(legacy_metadata)
                message(FATAL_ERROR "Existing VINC Python package has no recorded interpreter identity: ${legacy_metadata}. Select another build directory; no files were cleaned.")
            endif()
        endforeach()
    endif()
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_IDENTITY "${identity}")
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_APP "${app}")
    set_property(GLOBAL PROPERTY VINC_SELECTED_PYTHON_VERSION "${version}")
    set(_VINC_MODULE_PYTHON_IDENTITY "${identity}" CACHE INTERNAL "Kconfig binding interpreter" FORCE)
    set(_VINC_MODULE_PYTHON_ABI "${abi}" CACHE INTERNAL "Kconfig binding ABI" FORCE)
    set(VINC_SELECTED_PYTHON "${selected}" PARENT_SCOPE)
    set(VINC_SELECTED_PYTHON_APP "${app}" PARENT_SCOPE)
    foreach(field VERSION VERSION_MAJOR VERSION_MINOR POINTER_BYTES PLATFORM)
        set(VINC_SELECTED_PYTHON_${field} "${probe_${field}}" PARENT_SCOPE)
    endforeach()
    message(STATUS "App ${app}: Module Python ${selected} (${version}; ${abi})")
endfunction()
