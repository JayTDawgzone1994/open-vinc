include_guard(GLOBAL)

# Build-time registration only. C++ owns domains, codes, descriptions and validation.
function(vinc_register_error_catalog)
    cmake_parse_arguments(PARSE_ARGV 0 ERROR "" "TARGET;HEADER;SYMBOL" "")
    if(ERROR_UNPARSED_ARGUMENTS OR ERROR_KEYWORDS_MISSING_VALUES
       OR NOT ERROR_TARGET OR NOT ERROR_HEADER OR NOT ERROR_SYMBOL)
        message(FATAL_ERROR "vinc_register_error_catalog requires TARGET, HEADER and SYMBOL")
    endif()
    if(NOT TARGET "${ERROR_TARGET}")
        message(FATAL_ERROR "Error catalog provider target does not exist: ${ERROR_TARGET}")
    endif()
    if(NOT ERROR_HEADER MATCHES "^[A-Za-z0-9_./-]+$"
       OR NOT ERROR_SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$")
        message(FATAL_ERROR "Error catalog requires a literal include path and qualified C++ symbol")
    endif()
    get_target_property(finalized vinc_errors VINC_ERRORS_FINALIZED)
    if(finalized)
        message(FATAL_ERROR "Register error catalogs before vinc_finalize_error_catalog()")
    endif()
    get_target_property(symbols vinc_errors VINC_ERROR_SYMBOLS)
    if(ERROR_SYMBOL IN_LIST symbols)
        message(FATAL_ERROR "Error catalog registered twice: ${ERROR_SYMBOL}")
    endif()
    set_property(TARGET vinc_errors APPEND PROPERTY VINC_ERROR_HEADERS "${ERROR_HEADER}")
    set_property(TARGET vinc_errors APPEND PROPERTY VINC_ERROR_SYMBOLS "${ERROR_SYMBOL}")
    # Providers expose only error metadata and optional native formatting code.
    # Never pass a runtime component target here: it may depend on vinc::errors.
    target_link_libraries(vinc_errors PRIVATE "${ERROR_TARGET}")
endfunction()

function(vinc_finalize_error_catalog)
    get_target_property(finalized vinc_errors VINC_ERRORS_FINALIZED)
    if(finalized)
        message(FATAL_ERROR "vinc_finalize_error_catalog() must be called exactly once")
    endif()
    get_target_property(headers vinc_errors VINC_ERROR_HEADERS)
    get_target_property(symbols vinc_errors VINC_ERROR_SYMBOLS)
    if(NOT symbols)
        set(symbols)
        set(headers)
    endif()
    list(LENGTH symbols count)
    set(source "#include <vinc/error_catalog.hpp>\n#include <array>\n")
    foreach(header IN LISTS headers)
        string(APPEND source "#include <${header}>\n")
    endforeach()
    string(APPEND source "\nnamespace {\nconstexpr std::array<vinc::ErrorCatalog, ${count}> catalogs{\n")
    foreach(symbol IN LISTS symbols)
        string(APPEND source "    ${symbol},\n")
    endforeach()
    string(APPEND source "};\nstatic_assert(vinc::valid_catalogs(catalogs), \"Invalid or duplicate error catalog\");\n}\n\n")
    string(APPEND source "std::string vinc::error_to_string(const vinc::Error& error) {\n    return vinc::detail::format_error(error, catalogs);\n}\n")
    get_target_property(output_dir vinc_errors VINC_ERROR_OUTPUT_DIR)
    # No generator expressions are accepted in catalog metadata. Keep this input
    # outside the build tool's generated outputs so clean does not remove it.
    file(CONFIGURE OUTPUT "${output_dir}/error_catalog.cpp.in" CONTENT "${source}" @ONLY)
    set_property(TARGET vinc_errors PROPERTY VINC_ERRORS_FINALIZED TRUE)
endfunction()

function(_vinc_require_finalized_errors)
    get_target_property(finalized vinc_errors VINC_ERRORS_FINALIZED)
    if(NOT finalized)
        message(FATAL_ERROR "Call vinc_finalize_error_catalog() after adding all error providers")
    endif()
endfunction()
