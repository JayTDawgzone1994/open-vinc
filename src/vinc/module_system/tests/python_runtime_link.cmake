cmake_minimum_required(VERSION 3.20)
foreach(image IN ITEMS "${STATIC_IMAGE}" "${NATIVE_IMAGE}")
    execute_process(COMMAND "${DUMPBIN}" /IMPORTS "${image}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${image}: ${output}${error}")
    endif()
    string(TOLOWER "${output}" imports)
    if(image STREQUAL STATIC_IMAGE)
        if(imports MATCHES "(msvcp[0-9]+|msvcr[0-9]+|vcruntime[0-9]+|concrt[0-9]+|msvcp_win|msvcrtd?|ucrtbased?|api-ms-win-crt-)[a-z0-9_.-]*\\.dll")
            message(FATAL_ERROR "Static Python runtime image imports a dynamic CRT: ${output}")
        endif()
    elseif(NOT imports MATCHES "msvcp140d?\\.dll")
        message(FATAL_ERROR "Native Host no longer uses its expected dynamic C++ runtime: ${output}")
    endif()
endforeach()
execute_process(COMMAND "${STATIC_IMAGE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Static runtime bootstrap/catalog probe failed: ${output}${error}")
endif()
message(STATUS "Python static-runtime closure passed; native Host retains dynamic CRT")
