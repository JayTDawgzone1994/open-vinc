{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client"],
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["sdk/**/*.ts", "workspace/**/*.ts", "workspace/**/*.vue", "tests/**/*.ts", "*.ts"]
}
