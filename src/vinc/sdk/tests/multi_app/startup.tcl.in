if {[catch {
    # Central status remains queryable while a System Module waits to retry.
    ui status
    recorder status
    if {[info exists ::env(VINC_TEST_STOP_UI)]} {
        ui disable
        ui status
    }
    if {[@MODULE_TYPE@ [info nameofexecutable]] != 0} { error "Module startup failed" }
    if {[file exists [file join $::vinc::app_dir python vinc bootstrap.py]]} {
        if {[ScriptPeer --name python] != 0} { error "Python startup failed" }
        if {[python status] != 0} { error "Python command failed" }
    }
    puts "@APP_NAME@_SCRIPT_OK"
} diagnostic]} {
    puts "APP_TEST_FAILED: $diagnostic"
}
if {![info exists ::env(VINC_TEST_KEEP_RUNNING)]} {
    exit
}
