cmake_minimum_required(VERSION 3.20)
include("${HELPER}")
if(DEFINED FAILURE_CASE)
    if(FAILURE_CASE STREQUAL "record")
        file(SHA256 "${WORK}/official.txt" digest)
        file(WRITE "${WORK}/.vinc-owned-files" "${digest}|official.txt\n${digest}|../outside.txt\n")
        vinc_update_owned_files("${WORK}" "")
    elseif(FAILURE_CASE STREQUAL "temporary")
        vinc_update_owned_files("${WORK}" "official.txt")
    else()
        vinc_update_owned_files("${WORK}" "../outside.txt")
    endif()
    message(FATAL_ERROR "Invalid managed path was accepted")
endif()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/official.txt" "generated")
file(WRITE "${WORK}/modified.txt" "generated")
file(WRITE "${WORK}/user.txt" "user")
vinc_update_owned_files("${WORK}" "official.txt;modified.txt")
file(WRITE "${WORK}/modified.txt" "edited by user")
vinc_update_owned_files("${WORK}" "")
if(EXISTS "${WORK}/official.txt" OR NOT EXISTS "${WORK}/modified.txt" OR NOT EXISTS "${WORK}/user.txt")
    message(FATAL_ERROR "Managed file cleanup violated ownership")
endif()
message(STATUS "Managed generated file removed; modified/untracked files preserved")
foreach(failure_case record current)
    file(WRITE "${WORK}/official.txt" "generated")
    vinc_update_owned_files("${WORK}" "official.txt")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DHELPER=${HELPER}"
        "-DWORK=${WORK}" "-DFAILURE_CASE=${failure_case}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(result STREQUAL "0" OR NOT errors MATCHES "Invalid managed deployment path")
        message(FATAL_ERROR "Invalid path did not fail validation: ${output}${errors}")
    endif()
    if(NOT EXISTS "${WORK}/official.txt")
        message(FATAL_ERROR "Cleanup started before validating all paths")
    endif()
    # The child deliberately corrupts this fixture's record; restore it as data.
    file(WRITE "${WORK}/.vinc-owned-files" "")
endforeach()
message(STATUS "Traversal rejected before deleting any managed file")

# A staging record must not follow a pre-existing symlink either. Some Windows
# accounts cannot create symlinks; report that coverage limit explicitly.
file(WRITE "${WORK}/sentinel.txt" "preserve")
file(CREATE_LINK "${WORK}/sentinel.txt" "${WORK}/.vinc-owned-files.tmp"
    SYMBOLIC RESULT linked)
if(linked STREQUAL "0")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DHELPER=${HELPER}"
        "-DWORK=${WORK}" -DFAILURE_CASE=temporary -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(READ "${WORK}/sentinel.txt" sentinel)
    file(REMOVE "${WORK}/.vinc-owned-files.tmp")
    if(result STREQUAL "0" OR NOT errors MATCHES "Refusing managed symlink"
            OR NOT sentinel STREQUAL "preserve")
        message(FATAL_ERROR "Temporary record symlink was not rejected: ${output}${errors}")
    endif()
    message(STATUS "Temporary-record symlink rejected without modifying its target")
else()
    message(STATUS "SKIP temporary-record symlink: ${linked}")
endif()
