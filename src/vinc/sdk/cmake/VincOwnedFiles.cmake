# Build/deployment bookkeeping only. Delete a formerly managed file only while
# its bytes still match the recorded digest; user changes are preserved.
function(vinc_check_owned_path root relative)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)|[;|\\\\\r\n]")
        message(FATAL_ERROR "Invalid managed deployment path: ${relative}")
    endif()
    set(path "${root}/${relative}")
    cmake_path(NORMAL_PATH path)
    set(base "${root}")
    cmake_path(NORMAL_PATH base)
    cmake_path(IS_PREFIX base "${path}" NORMALIZE inside)
    if(NOT inside OR path STREQUAL base)
        message(FATAL_ERROR "Managed file escaped deployment root: ${relative}")
    endif()
    while(TRUE)
        if(IS_SYMLINK "${path}")
            message(FATAL_ERROR "Refusing managed symlink/junction: ${path}")
        endif()
        get_filename_component(parent "${path}" DIRECTORY)
        if(path STREQUAL parent)
            break()
        endif()
        set(path "${parent}")
    endwhile()
endfunction()

function(vinc_update_owned_files root files)
    set(record "${root}/.vinc-owned-files")
    vinc_check_owned_path("${root}" ".vinc-owned-files")
    vinc_check_owned_path("${root}" ".vinc-owned-files.tmp")
    set(previous)
    if(EXISTS "${record}")
        file(STRINGS "${record}" previous ENCODING UTF-8)
    endif()
    # Validate every old entry before any deletion. The file is data, never an
    # include() script; traversal and symlink ancestors cannot redirect cleanup.
    foreach(entry IN LISTS previous)
        if(NOT entry MATCHES "^([0-9a-f]+)\\|(.+)$")
            message(FATAL_ERROR "Invalid managed-file record: ${record}")
        endif()
        vinc_check_owned_path("${root}" "${CMAKE_MATCH_2}")
    endforeach()
    foreach(relative IN LISTS files)
        vinc_check_owned_path("${root}" "${relative}")
    endforeach()
    foreach(entry IN LISTS previous)
        string(REGEX MATCH "^([0-9a-f]+)\\|(.+)$" matched "${entry}")
        set(digest "${CMAKE_MATCH_1}")
        set(relative "${CMAKE_MATCH_2}")
        set(path "${root}/${relative}")
        if(NOT relative IN_LIST files AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
            file(SHA256 "${path}" actual)
            if(actual STREQUAL digest)
                file(REMOVE "${path}")
            else()
                message(STATUS "Preserving modified formerly managed file: ${path}")
            endif()
        endif()
    endforeach()
    set(contents "")
    foreach(relative IN LISTS files)
        set(path "${root}/${relative}")
        if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
            file(SHA256 "${path}" digest)
            string(APPEND contents "${digest}|${relative}\n")
        endif()
    endforeach()
    file(WRITE "${record}.tmp" "${contents}")
    file(RENAME "${record}.tmp" "${record}")
endfunction()
