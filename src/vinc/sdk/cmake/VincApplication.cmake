include_guard(GLOBAL)

# One composer serves source and installed SDK consumers.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/VincModule.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/VincModule.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/VincMessages.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/VincApp.cmake")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/../../module_system/cmake/VincModule.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../../ribosome/cmake/VincMessages.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/../../../../apps/vinc/cmake/VincApp.cmake")
    get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
    set_property(GLOBAL PROPERTY VINC_APPLICATION_SOURCE_ROOT "${source_root}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VincConfiguration.cmake")

function(vinc_prepare_installed_messages)
    if(TARGET vinc::messages)
        return()
    endif()
    get_filename_component(prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    set(generated "${CMAKE_BINARY_DIR}/vinc_generated/include")
    add_library(vinc_messages INTERFACE)
    add_library(vinc::messages ALIAS vinc_messages)
    target_include_directories(vinc_messages INTERFACE "${generated}")
    target_link_libraries(vinc_messages INTERFACE vinc::message_storage)
    target_compile_features(vinc_messages INTERFACE cxx_std_23)
    set_property(GLOBAL PROPERTY VINC_MESSAGE_OUTPUT "${generated}/vinc_messages")
    set_property(GLOBAL PROPERTY VINC_MESSAGE_TEMPLATE "${prefix}/share/vinc/ribosome/message_sample.txt")
    set_property(GLOBAL PROPERTY VINC_MESSAGE_GENERATOR vinc::ribosome)
    add_message_dir("${prefix}/share/vinc/messages")
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL vinc_finalize_messages)
endfunction()

# Source locations are shared; generated configuration remains App-local.
function(vinc_app_material output)
    get_property(root GLOBAL PROPERTY VINC_APPLICATION_SOURCE_ROOT)
    if(root)
        set(main "${root}/apps/vinc/src/main.cpp")
        set(configuration "${root}/tools/configure")
        set(bag "${root}/src/vinc/bag/module")
        set(ui "${root}/src/vinc/ui/module")
        set(python "${root}/src/vinc/module_system/python")
        set(pybind "${root}/library/pybind11/upstream")
        set(source TRUE)
    else()
        get_filename_component(prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
        set(data "${prefix}/share/vinc")
        set(main "${data}/application/main.cpp")
        set(configuration "${data}/configuration")
        set(bag "${data}/modules/bag")
        set(ui "${data}/modules/ui")
        set(python "${data}/python")
        set(pybind "${data}/python/pybind11")
        set(source FALSE)
    endif()
    foreach(name main configuration bag ui python pybind source)
        string(TOUPPER "${name}" key)
        set(${output}_${key} "${${name}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(vinc_add_app target)
    cmake_parse_arguments(PARSE_ARGV 1 APP "" "INSTANCE_NAME;VINC_BUILD_CONFIG;STARTUP_SCRIPT" "")
    if(APP_UNPARSED_ARGUMENTS OR APP_KEYWORDS_MISSING_VALUES OR
            NOT APP_INSTANCE_NAME OR NOT APP_VINC_BUILD_CONFIG)
        message(FATAL_ERROR "vinc_add_app requires INSTANCE_NAME and VINC_BUILD_CONFIG; optional STARTUP_SCRIPT")
    endif()
    if(NOT target MATCHES "^[A-Za-z_][A-Za-z0-9_-]*$")
        message(FATAL_ERROR "Application target must be an ASCII identifier (hyphens allowed)")
    endif()
    string(LENGTH "${APP_INSTANCE_NAME}" name_length)
    if(NOT APP_INSTANCE_NAME MATCHES "^[a-z0-9_-]+$" OR name_length GREATER 48)
        message(FATAL_ERROR "INSTANCE_NAME requires 1..48 lowercase ASCII letters, digits, _ or -")
    endif()
    foreach(component ui bag)
        if(NOT TARGET vinc::${component})
            message(FATAL_ERROR "App ${target} requires the official ${component} SDK capability")
        endif()
    endforeach()
    vinc_app_material(material)
    vinc_prepare_installed_messages()
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/${target}_generated/$<CONFIG>")
    add_executable(${target} "${material_MAIN}")
    target_link_libraries(${target} PRIVATE vinc::shell vinc::module_runtime)
    target_include_directories(${target} PRIVATE "${generated}")
    target_compile_definitions(${target} PRIVATE VINC_COMPOSED_APP)
    set_target_properties(${target} PROPERTIES
        CXX_STANDARD 23 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF
        MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${target}/$<CONFIG>"
        VINC_APP_GENERATED "${generated}" VINC_APP_IDENTITY "${APP_INSTANCE_NAME}")
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8)
    endif()
    file(GENERATE OUTPUT "${generated}/vinc_app_config.hpp" CONTENT
        "#pragma once\n#include <string_view>\nnamespace vinc::app {\ninline constexpr std::string_view instance_name = \"${APP_INSTANCE_NAME}\";\n}\n")
    if(APP_STARTUP_SCRIPT)
        get_filename_component(script "${APP_STARTUP_SCRIPT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${script}" OR IS_DIRECTORY "${script}")
            message(FATAL_ERROR "Startup script is not a file: ${script}")
        endif()
        vinc_embed_startup(${target} "${script}")
    endif()

    vinc_prepare_official_modules(${target})
    set(python_available FALSE)
    if(EXISTS "${material_PYTHON}/cmake/VincPython.cmake" AND EXISTS "${material_PYBIND}/CMakeLists.txt")
        set(python_available TRUE)
    endif()
    vinc_register_app_configuration(${target}
        CONFIG "${APP_VINC_BUILD_CONFIG}" TOOL_DIRECTORY "${material_CONFIGURATION}"
        UI_AVAILABLE TRUE BAG_AVAILABLE TRUE PYTHON_AVAILABLE "${python_available}")
    vinc_prepare_app_features(${target} "${python_available}")
    set_property(GLOBAL APPEND PROPERTY VINC_APPLICATION_TARGETS "${target}")
    get_property(scheduled GLOBAL PROPERTY VINC_APPLICATIONS_SCHEDULED)
    if(NOT scheduled)
        set_property(GLOBAL PROPERTY VINC_APPLICATIONS_SCHEDULED TRUE)
        # Configuration was scheduled first; both passes see all registered Apps.
        cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL vinc_finalize_applications)
    endif()
endfunction()

# Dependency subdirectories cannot be created during CMake deferred execution.
# Read only feature choices here; final resolution validates registered Modules.
function(vinc_prepare_app_features app python_available)
    foreach(name FILE TOOL OUTPUT INTERPRETER)
        get_target_property(${name} ${app} VINC_APP_CONFIG_${name})
    endforeach()
    set(available n)
    if(python_available)
        set(available y)
    endif()
    execute_process(COMMAND "${INTERPRETER}" -B "${TOOL}/configure.py"
        --config "${FILE}" --require-file --preflight --output "${OUTPUT}/preflight"
        --python-available "${available}"
        RESULT_VARIABLE result OUTPUT_VARIABLE summary ERROR_VARIABLE errors)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "App ${app}: ${summary}${errors}")
    endif()
    include("${OUTPUT}/preflight/features.cmake")
    if(VINC_APP_PYTHON)
        vinc_prepare_app_python(${app})
    endif()
endfunction()

# Official adapters are not selectable project-wide Modules. UI is App-local.
function(vinc_prepare_official_modules app)
    vinc_app_material(material)
    get_target_property(generated ${app} VINC_APP_GENERATED)
    get_target_property(identity ${app} VINC_APP_IDENTITY)
    get_property(bag GLOBAL PROPERTY VINC_APP_BAG_TARGET)
    if(NOT bag)
        set(bag vinc_app_bag_recorder)
        vinc_add_module_plugin(${bag} "${material_BAG}/recorder_module.cpp")
        if(MSVC)
            target_compile_options(${bag} PRIVATE /utf-8)
        endif()
        target_link_libraries(${bag} PRIVATE vinc::sdk vinc::bag vinc::messages)
        set_target_properties(${bag} PROPERTIES EXCLUDE_FROM_ALL TRUE
            VINC_MODULE_TYPE bagRecorder VINC_STOP_TIMEOUT_CONFIG bag_stop_timeout)
        set_property(GLOBAL PROPERTY VINC_APP_BAG_TARGET "${bag}")
    endif()
    set(ui "${app}_vinc_ui")
    vinc_add_module_plugin(${ui} "${material_UI}/ui_module.cpp"
        "${material_UI}/topic_monitor.cpp" "${material_UI}/graph.cpp")
    if(MSVC)
        target_compile_options(${ui} PRIVATE /utf-8)
    endif()
    target_link_libraries(${ui} PRIVATE vinc::sdk vinc::ui vinc::messages)
    if(material_SOURCE)
        target_link_libraries(${ui} PRIVATE vinc_ui_json)
    else()
        target_link_libraries(${ui} PRIVATE vinc::detail_ui_json)
    endif()
    target_compile_definitions(${ui} PRIVATE VINC_COMPOSED_APP)
    target_include_directories(${ui} PRIVATE "${generated}")
    set_target_properties(${ui} PROPERTIES EXCLUDE_FROM_ALL TRUE
        VINC_MODULE_TYPE webUi VINC_STOP_TIMEOUT_CONFIG ui_stop_timeout)
    file(GENERATE OUTPUT "${generated}/vinc_ui_paths.hpp" CONTENT
        "#pragma once\ninline constexpr auto vinc_ui_default_root = \"vinc_data/${identity}/ui\";\n")
    set_property(TARGET ${app} PROPERTY VINC_APP_OFFICIAL_MODULE_TARGETS "${bag};${ui}")
endfunction()

function(vinc_prepare_app_python app)
    vinc_app_material(material)
    if(NOT TARGET vinc_python_native)
        include("${material_PYTHON}/cmake/VincPython.cmake")
        set(options)
        if(material_SOURCE)
            list(APPEND options SOURCE_CHECKOUT)
        endif()
        vinc_build_python_bindings(vinc_python_native "${material_PYTHON}" "${material_PYBIND}"
            "${CMAKE_BINARY_DIR}/vinc-python/$<CONFIG>/vinc" ${options})
        set_property(TARGET vinc_python_native PROPERTY EXCLUDE_FROM_ALL TRUE)
    endif()
    get_target_property(source vinc_python_native VINC_PYTHON_SOURCE_ROOT)
    get_target_property(interpreter vinc_python_native VINC_PYTHON_ABI_EXECUTABLE)
    if(NOT source STREQUAL material_PYTHON)
        message(FATAL_ERROR "App ${app}: cannot reuse foreign Python binding target")
    endif()
    if(DEFINED Python_EXECUTABLE AND NOT Python_EXECUTABLE STREQUAL interpreter)
        message(FATAL_ERROR "Apps in one build must use the same Python ABI interpreter")
    endif()
    set_property(TARGET ${app} PROPERTY VINC_APP_PYTHON_TARGET vinc_python_native)
    add_dependencies(${app} vinc_python_native)
endfunction()

function(vinc_finalize_applications)
    get_property(apps GLOBAL PROPERTY VINC_APPLICATION_TARGETS)
    foreach(app IN LISTS apps)
        get_target_property(modules ${app} VINC_APP_MODULE_TARGETS)
        get_target_property(generated ${app} VINC_APP_GENERATED)
        vinc_render_module_catalog(body DEPLOYED ${modules})
        set(catalog "#pragma once\n#include <vinc/module/host/module_manager.hpp>\n#include <vinc/config.hpp>\nnamespace vinc {\ninline Result<void> register_built_modules(ModuleManager& manager, const std::filesystem::path& directory) {\n${body}    return {};\n}\n}\n")
        file(GENERATE OUTPUT "${generated}/module_catalog.hpp" CONTENT "${catalog}")
        vinc_deploy_application(${app})
    endforeach()
endfunction()

# One manifest feeds build repair and installation. Inputs are build artifacts,
# never the App's live data/log/parameter/plugin directories.
function(vinc_deploy_application app)
    vinc_app_material(material)
    get_target_property(generated ${app} VINC_APP_GENERATED)
    get_target_property(identity ${app} VINC_APP_IDENTITY)
    get_target_property(modules ${app} VINC_APP_MODULE_TARGETS)
    get_target_property(with_python ${app} VINC_APP_PYTHON)
    if(material_SOURCE)
        get_property(root GLOBAL PROPERTY VINC_APPLICATION_SOURCE_ROOT)
        get_property(ui_source GLOBAL PROPERTY VINC_UI_DIST)
        set(tcl_source "${root}/library/tcl/upstream")
        set(license_source "${root}")
    else()
        get_filename_component(prefix "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
        set(ui_source "${prefix}/share/vinc/ui")
        set(tcl_source "${prefix}/share/vinc/tcl")
        set(license_source "${prefix}/share/vinc/licenses")
    endif()
    string(CONCAT contents
        "set(destination [==[$<TARGET_FILE_DIR:${app}>]==])\n"
        "set(app_source [==[$<TARGET_FILE:${app}>]==])\n"
        "set(app_name [==[$<TARGET_FILE_NAME:${app}>]==])\n"
        "set(app_target ${app})\n"
        "set(identity ${identity})\n"
        "set(with_python ${with_python})\n")
    foreach(name ui_source tcl_source license_source)
        string(APPEND contents "set(${name} [==[${${name}}]==])\n")
    endforeach()
    foreach(module IN LISTS modules)
        get_target_property(type ${module} VINC_MODULE_TYPE)
        string(APPEND contents
            "list(APPEND module_sources [==[$<TARGET_FILE:${module}>]==])\n"
            "list(APPEND module_destinations [==[modules/${type}/$<TARGET_FILE_NAME:${module}>]==])\n")
    endforeach()
    set(dependencies ${modules})
    if(with_python)
        get_target_property(binding ${app} VINC_APP_PYTHON_TARGET)
        get_target_property(python_source ${binding} VINC_PYTHON_DIRECTORY)
        get_target_property(resources ${binding} VINC_PYTHON_RESOURCES)
        string(APPEND contents "set(python_source [==[${python_source}]==])\nset(python_resources [==[${resources}]==])\n")
        list(APPEND dependencies ${binding})
    endif()
    set(manifest "${generated}/deployment.cmake")
    set(script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/DeployApplication.cmake")
    file(GENERATE OUTPUT "${manifest}" CONTENT "${contents}")
    add_custom_target(${app}_deployment
        COMMAND "${CMAKE_COMMAND}" "-DMANIFEST=${manifest}" -P "${script}"
        DEPENDS ${dependencies} VERBATIM)
    add_dependencies(${app} ${app}_deployment)

    # App-specific install roots/components prevent one App's cleanup from
    # treating another App's binaries as obsolete. DESTDIR remains supported.
    set(install_code "execute_process(COMMAND [==[${CMAKE_COMMAND}]==] [==[-DMANIFEST=${manifest}]==] \"-DDEPLOY_TO=\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/${app}\" -DCOPY_APPLICATION=ON -P [==[${script}]==] COMMAND_ERROR_IS_FATAL ANY)\n")
    file(GENERATE OUTPUT "${generated}/install.cmake" CONTENT "${install_code}")
    install(SCRIPT "${generated}/install.cmake" COMPONENT "VincApp_${app}")
endfunction()
