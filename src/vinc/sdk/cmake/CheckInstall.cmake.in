if(NOT CMAKE_INSTALL_CONFIG_NAME STREQUAL "@CMAKE_BUILD_TYPE@")
    message(FATAL_ERROR "Install this SDK with --config @CMAKE_BUILD_TYPE@; configuration fallback is not supported")
endif()
set(profile "@VINC_SDK_VERSION@|@CMAKE_SYSTEM_NAME@|@CMAKE_CXX_COMPILER_ID@|@CMAKE_CXX_COMPILER_VERSION@|@CMAKE_BUILD_TYPE@|@VINC_SDK_ABI@|@VINC_CONFIG_HASH@")
set(marker "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cmake/vinc/profile.txt")
if(EXISTS "${marker}")
    file(READ "${marker}" installed_profile)
    if(NOT installed_profile STREQUAL profile)
        message(FATAL_ERROR "SDK prefix contains a different build profile. Install into a separate prefix; do not mix versions/configurations/toolchains.")
    endif()
endif()
