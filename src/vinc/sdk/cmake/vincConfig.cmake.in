@PACKAGE_INIT@

# Check before creating imported targets: a failed optional lookup must not
# leave a partially usable package in the consumer's build graph.
if(NOT CMAKE_CXX_COMPILER_LOADED)
    set(vinc_FOUND FALSE)
    set(vinc_NOT_FOUND_MESSAGE "Enable CXX in project() before finding vinc")
    return()
endif()
if(CMAKE_CROSSCOMPILING OR CMAKE_CONFIGURATION_TYPES
        OR NOT CMAKE_BUILD_TYPE STREQUAL "@CMAKE_BUILD_TYPE@"
        OR NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@"
        OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@"
        OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@"
        OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(vinc_FOUND FALSE)
    set(vinc_NOT_FOUND_MESSAGE "SDK requires native @CMAKE_SYSTEM_NAME@, @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@, 64-bit, single-config @CMAKE_BUILD_TYPE@")
    return()
endif()
set(vinc_FOUND TRUE)
foreach(component IN LISTS vinc_FIND_COMPONENTS)
    set(vinc_${component}_FOUND FALSE)
endforeach()
check_required_components(vinc)
if(DEFINED vinc_FOUND AND NOT vinc_FOUND)
    return()
endif()
if(TARGET vinc::sdk)
    get_target_property(existing_package vinc::sdk VINC_PACKAGE_DIRECTORY)
    if(NOT existing_package STREQUAL CMAKE_CURRENT_LIST_DIR)
        message(FATAL_ERROR "Do not mix source/installed Vinc or different SDK prefixes in one build")
    endif()
    return()
endif()

set_and_check(vinc_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set_and_check(vinc_DATA_DIR "${PACKAGE_PREFIX_DIR}/share/vinc")
file(SHA256 "${vinc_INCLUDE_DIR}/vinc/config.hpp" config_hash)
if(NOT config_hash STREQUAL "@VINC_CONFIG_HASH@")
    message(FATAL_ERROR "Installed vinc/config.hpp differs from the compiled SDK; rebuild the SDK")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CheckSdkAbi.cmake")
vinc_check_sdk_abi(consumer_abi)
if(NOT consumer_abi STREQUAL "@VINC_SDK_ABI@")
    message(FATAL_ERROR "Vinc SDK standard-library/architecture/CRT ABI mismatch. SDK: @VINC_SDK_ABI@ Consumer: ${consumer_abi}")
endif()

# System libraries remain system dependencies; pinned static third-party
# archives are shipped with the SDK rather than rebuilt during find_package.
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT WIN32)
    find_dependency(ZLIB)
endif()
# find_dependency may change PACKAGE_PREFIX_DIR with older CMake packages.
get_filename_component(_vinc_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/VincTclTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VincTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VincTools.cmake")
set_property(TARGET vinc::sdk PROPERTY VINC_PACKAGE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/VincInstalledResources.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VincMsvcDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VincApplication.cmake")
set(vinc_VERSION "@VINC_SDK_VERSION@")
set(vinc_FOUND TRUE)
