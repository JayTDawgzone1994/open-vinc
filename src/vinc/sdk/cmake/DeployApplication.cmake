cmake_minimum_required(VERSION 3.20)
include("${MANIFEST}")
include("${CMAKE_CURRENT_LIST_DIR}/VincOwnedFiles.cmake")
if(DEFINED DEPLOY_TO)
    set(destination "${DEPLOY_TO}")
endif()
if(NOT IS_ABSOLUTE "${destination}" OR NOT identity MATCHES "^[a-z0-9_-]+$")
    message(FATAL_ERROR "Invalid application deployment root/identity")
endif()
set(reserved_names modules lib licenses vinc_data python .vinc-app-deploy.lock .vinc-owned-files .vinc-app-owner)
set(application_name "${app_name}")
if(WIN32)
    string(TOLOWER "${application_name}" application_name)
endif()
if(application_name IN_LIST reserved_names)
    message(FATAL_ERROR "Application filename collides with a framework deployment resource: ${app_name}")
endif()

# Expand only build-owned input trees, never live deployment directories.
macro(append_file source relative)
    list(APPEND module_sources "${source}")
    list(APPEND module_destinations "${relative}")
endmacro()
macro(append_tree source prefix)
    if(NOT IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Missing deployment input tree: ${source}")
    endif()
    file(GLOB_RECURSE entries LIST_DIRECTORIES false RELATIVE "${source}" "${source}/*")
    foreach(entry IN LISTS entries)
        append_file("${source}/${entry}" "${prefix}/${entry}")
    endforeach()
endmacro()

# Compatibility with the older manifest is intentionally not supported.
append_tree("${tcl_source}/library" "lib/tcl9.1")
append_file("${tcl_source}/license.terms" "lib/tcl9.1/license.terms")
append_file("${tcl_source}/utf8proc/LICENSE.md" "lib/tcl9.1/licenses/utf8proc.txt")
append_file("${tcl_source}/libtommath/LICENSE" "lib/tcl9.1/licenses/libtommath.txt")
append_file("${tcl_source}/compat/zlib/LICENSE" "lib/tcl9.1/licenses/zlib.txt")
foreach(name LICENSE NOTICE THIRD_PARTY_NOTICES.txt)
    append_file("${license_source}/${name}" "licenses/open-vinc/${name}")
endforeach()
foreach(owned app plugins/vinc.example plugins/vinc.topics plugins/vinc.graph)
    append_tree("${ui_source}/${owned}" "vinc_data/${identity}/ui/${owned}")
endforeach()
if(with_python)
    foreach(relative IN LISTS python_resources)
        append_file("${python_source}/${relative}" "python/vinc/${relative}")
    endforeach()
endif()
if(COPY_APPLICATION)
    append_file("${app_source}" "${app_name}")
endif()

# Validate the full plan before copying or cleaning anything.
list(LENGTH module_sources source_count)
list(LENGTH module_destinations destination_count)
if(NOT source_count EQUAL destination_count)
    message(FATAL_ERROR "Mismatched deployment source/destination lists")
endif()
set(keys)
foreach(relative IN LISTS module_destinations)
    vinc_check_owned_path("${destination}" "${relative}")
    set(key "${relative}")
    if(WIN32)
        string(TOLOWER "${key}" key)
    endif()
    if(key IN_LIST keys)
        message(FATAL_ERROR "Plugin deployment paths collide: ${relative}")
    endif()
    list(APPEND keys "${key}")
endforeach()
foreach(source IN LISTS module_sources)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Missing deployment input: ${source}")
    endif()
endforeach()
foreach(record .vinc-app-deploy.lock .vinc-app-owner .vinc-owned-files .vinc-owned-files.tmp)
    vinc_check_owned_path("${destination}" "${record}")
endforeach()
file(MAKE_DIRECTORY "${destination}")
set(copy_lock_timeout_seconds 60)
file(LOCK "${destination}/.vinc-app-deploy.lock" GUARD PROCESS
    TIMEOUT ${copy_lock_timeout_seconds} RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
    message(FATAL_ERROR "Application deployment lock failed: ${locked}")
endif()
set(owner "${app_target}|${identity}")
if(EXISTS "${destination}/.vinc-app-owner")
    file(READ "${destination}/.vinc-app-owner" previous_owner)
    if(NOT previous_owner STREQUAL owner)
        message(FATAL_ERROR "Deployment directory belongs to another App: ${previous_owner}")
    endif()
endif()
# The marker is data and never executed. Preserve it even after a failed copy so
# another App cannot claim and partially overwrite this directory on retry.
file(WRITE "${destination}/.vinc-app-owner" "${owner}")
math(EXPR last "${source_count} - 1")
foreach(index RANGE 0 ${last})
    list(GET module_sources ${index} source)
    list(GET module_destinations ${index} relative)
    get_filename_component(parent "${destination}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${source}" "${destination}/${relative}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
# A build deployment runs before linking. Keep the executable in the desired set
# even when it does not exist yet; cleanup must never remove the live build output.
list(APPEND module_destinations "${app_name}")
list(REMOVE_DUPLICATES module_destinations)
vinc_update_owned_files("${destination}" "${module_destinations}")
