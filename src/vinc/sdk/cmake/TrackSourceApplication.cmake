cmake_minimum_required(VERSION 3.20)
include("${MANIFEST}")
include("${CMAKE_CURRENT_LIST_DIR}/VincOwnedFiles.cmake")
set(files)
foreach(path IN LISTS module_files)
    file(RELATIVE_PATH relative "${root}" "${path}")
    list(APPEND files "${relative}")
endforeach()
if(with_ui)
    foreach(owned app plugins/vinc.example plugins/vinc.topics plugins/vinc.graph)
        # Enumerate source assets, not arbitrary files in the user's UI tree.
        file(GLOB_RECURSE assets RELATIVE "${ui_dist}/${owned}" "${ui_dist}/${owned}/*")
        foreach(asset IN LISTS assets)
            file(RELATIVE_PATH relative "${root}" "${ui_root}/${owned}/${asset}")
            list(APPEND files "${relative}")
        endforeach()
    endforeach()
endif()
if(with_python)
    foreach(path IN LISTS python_resources)
        file(RELATIVE_PATH relative "${root}" "${python_root}/${path}")
        list(APPEND files "${relative}")
    endforeach()
endif()
file(LOCK "${root}/.vinc-app-deploy.lock" GUARD PROCESS TIMEOUT 60)
vinc_update_owned_files("${root}" "${files}")
